{
    "name": "launch-forms/launch-forms",
    "description": "Lightweight WordPress form builder that inherits theme styling.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^4.0",
        "wp-phpunit/wp-phpunit": "7.1.3"
    },
    "scripts": {
        "install-wp-tests": "bash bin/install-wp-tests.sh",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
